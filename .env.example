# Copy to .env and fill in. Leave a service blank to skip it; the dashboard
# marks it "not connected" instead of showing numbers.

# ---------- server ----------
# The start and share-link scripts expect 8080.
PORT=8080
# Time zone the shop works in. "Today" and daily totals use it.
TZ=America/Chicago
# Sign-in: the first account becomes the owner and must be created on this
# PC (http://localhost:8080). To create it from another device instead, put
# the owner's email here.
OWNER_EMAIL=
# Keep false until the numbers look right. While false, automations only log
# what they would do: no texts are sent and no campaigns are changed.
AUTOMATIONS_LIVE=false

# ---------- business ----------
BUSINESS_NAME=Modern HVAC Tech
BUSINESS_TAGLINE=Service Operations
BUSINESS_REGION=Service region
BOOKING_URL=
# Your Google "write a review" link (Business Profile > Ask for reviews).
REVIEW_URL=
OPEN_HOUR=7
CLOSE_HOUR=18
# Named areas for the map, "Name:lat,lng;Name:lat,lng". The first is HQ.
SERVICE_ZONES=
# Optional fixed map box "south,west,north,east". Blank = fit to job addresses.
SERVICE_AREA_BOUNDS=

# ---------- targets ----------
TARGET_ANSWER_RATE=0.9
TARGET_SAME_DAY=0.85
TARGET_MAX_CPL=65
TARGET_DISPATCH_MINUTES=10

# ---------- Housecall Pro (jobs, techs, estimates, on-my-way) ----------
# Housecall Pro > App Store > API > Generate key (MAX plan). When set, jobs
# come from Housecall Pro and the built-in job board is hidden.
HOUSECALL_API_KEY=
# Optional: {"employeeId":"Plumbing"}; otherwise inferred from each tech's jobs.
HOUSECALL_TECH_TRADES=
# Dispatcher's mobile: gets a text naming the closest free tech for unassigned jobs.
MANAGER_PHONE=
# No Housecall Pro? Set true to use the dashboard's own simple job board.
JOB_BOARD=false

# ---------- Calls ----------
# Which calls to count: "twilio", "ooma" (CSV uploads on the Team page) or
# "both". "auto" = Twilio when it is set up, otherwise Ooma uploads.
# Use "both" only if the two never see the same call (no forwarding between them).
CALL_SOURCE=auto

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Number the automations text from (E.164, e.g. +15125550100).
TWILIO_FROM_NUMBER=
# Comma-separated business numbers to count. Blank = all numbers on the account.
TWILIO_TRACKED_NUMBERS=
TWILIO_MIN_ANSWERED_SECONDS=20

# ---------- Google Maps (job addresses on the dispatch map) ----------
# Cloud Console > APIs & Services > enable "Geocoding API" > Credentials >
# Create API key, restricted to the Geocoding API.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=us

# ---------- Google (one login for all four) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Desktop app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Run `npm run google-auth` to get this.
GOOGLE_REFRESH_TOKEN=

# Google Ads & Local Services Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Manager (MCC) id, only when you sign in through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# Google Analytics 4 property id (numbers only) and the quote-form event name.
GA4_PROPERTY_ID=
GA4_QUOTE_EVENT=generate_lead

# Google Business Profile ids: run `npm run gbp-ids` after the Google sign-in to list them.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Search Console property, e.g. https://www.example.com/ or sc-domain:example.com
GSC_SITE_URL=
# Keywords to track, comma-separated. Blank = your top 12 queries.
GSC_KEYWORDS=hvac repair near me,emergency plumber,ac repair,water heater repair,furnace repair near me

# ---------- Meta Ads ----------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0

# ---------- Samsara GPS (optional) ----------
SAMSARA_API_TOKEN=
# Optional: {"Truck 12":"housecallEmployeeId"}; otherwise vehicle name = tech name.
SAMSARA_VEHICLE_TECHS=
